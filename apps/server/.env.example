# Server Configuration
PORT=3001

# JWT Secret (change this in production!)
# Used for signing and verifying JWT tokens
JWT_SECRET=your-secret-key-change-in-production

# Solana RPC URL
# Configure based on network (devnet/mainnet)
RPC_URL=https://api.devnet.solana.com

# Anchor
ANCHOR_PROVIDER_URL=
ANCHOR_WALLET=

# Turnkey Credentials
# MPC
API_PRIVATE_KEY=
API_PUBLIC_KEY=
ORGANIZATION_ID=
SERVER_PRIVATE_KEY_ID=
SERVER_PUBLIC_KEY_ID=

# Frontend URL
FRONTEND_URL=

# Worker URL
WORKER_URL

# Database URL
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/flott

# Program ID (optional, for reference)
